{
  "name": "tiny-spark",
  "private": false,
  "version": "1.3.0",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "description": "An elegant, reactive and responsive sparkline chart solution without dependency.",
  "author": "Alec Lloyd Probert",
  "main": "./dist/tiny-spark.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "types": "./dist/src/index.d.ts",
    "default": "./dist/tiny-spark.es.js"
  },
  "keywords": [
    "sparkline",
    "chart",
    "mini chart",
    "line",
    "framework agnostic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphieros/tiny-spark.git"
  },
  "homepage": "https://tiny-spark.graphieros.com/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit false --declaration --emitDeclarationOnly --noEmitOnError --outDir dist"
  },
  "files": [
    "dist/tiny-spark.es.js",
    "dist/src/index.d.ts"
  ],
  "devDependencies": {
    "@types/node": "^24.0.8",
    "typescript": "~5.8.3",
    "vite": "^8.2.1"
  }
}
